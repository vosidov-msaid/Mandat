{
  "name": "mandat",
  "version": "0.1.4",
  "description": "Authorization, delegation and audit for AI agent actions (MCP-first). Policy on every tool call, per-task delegated tokens, hash-chained audit ledger, MCP scanner.",
  "license": "Apache-2.0",
  "author": "Muhammadsaid Vosidov",
  "homepage": "https://github.com/vosidov-msaid/Mandat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vosidov-msaid/Mandat.git"
  },
  "bugs": {
    "url": "https://github.com/vosidov-msaid/Mandat/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mandat": "dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "prepack": "node scripts/build.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "controlplane": "node bin/mandat.ts serve",
    "demo:server": "node examples/refund-server/server.ts",
    "demo": "node examples/demo.ts",
    "demo:sdk-server": "node examples/sdk-server/server.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/express": "5.0.6",
    "@types/node": "^26.6.5",
    "express": "5.3.0",
    "typescript": "^5.9.3",
    "zod": "4.6.7"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "authorization",
    "oauth",
    "token-exchange",
    "audit",
    "security"
  ]
}
